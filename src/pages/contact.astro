---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, PHONE, PHONE_TEL, EMAIL, ADDRESS, LAT, LNG } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Contact Us | ${SITE_TITLE}`} description="Request a free AC quote or ask a question. We respond quickly to Huntersville homeowners." />
	</head>
	<body>
		<Header />

		<section class="page-hero">
			<div class="container">
				<h1>Contact Us</h1>
				<p>Request a free quote or ask a question. We respond quickly to Huntersville and Lake Norman homeowners.</p>
			</div>
		</section>

		<section class="section">
			<div class="container contact-grid">
				<div class="contact-info">
					<h2>Get in Touch</h2>
					<p><strong>Phone:</strong> <a href={`tel:${PHONE_TEL}`}>{PHONE}</a></p>
					<p><strong>Email:</strong> <a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
					<p><strong>Address:</strong> {ADDRESS}</p>
					<p><strong>Service Area:</strong> Huntersville, NC and nearby communities including Cornelius, Davidson, Mooresville, and the greater Lake Norman area.</p>
					<p style="margin-top: 1.25rem;">Prefer to talk? Call us during business hours for the fastest response. For emergencies, leave a message and we will get back to you as soon as possible.</p>
					<p style="margin-top: 1.5rem;">
						<a href={`tel:${PHONE_TEL}`} class="btn btn-primary">Call Now</a>
					</p>
				</div>

				<div>
					<h2>Request a Free Quote</h2>
					<form action="#" method="POST" onsubmit="event.preventDefault(); alert('Thank you! This is a demo form. Please call us for a real quote.');">
						<div class="field">
							<label for="name">Name</label>
							<input type="text" id="name" name="name" required placeholder="Your name" />
						</div>
						<div class="field">
							<label for="phone">Phone</label>
							<input type="tel" id="phone" name="phone" required placeholder="(704) 555-0000" />
						</div>
						<div class="field">
							<label for="email">Email</label>
							<input type="email" id="email" name="email" placeholder="you@example.com" />
						</div>
						<div class="field">
							<label for="service">Service Needed</label>
							<select id="service" name="service">
								<option value="repair">AC Repair</option>
								<option value="install">AC Installation</option>
								<option value="emergency">Emergency Repair</option>
								<option value="maintenance">Maintenance</option>
								<option value="duct">Duct Cleaning</option>
								<option value="other">Other</option>
							</select>
						</div>
						<div class="field">
							<label for="message">Message</label>
							<textarea id="message" name="message" placeholder="Tell us about your AC issue or project..."></textarea>
						</div>
						<button type="submit" class="btn btn-primary">Send Message</button>
					</form>
				</div>
			</div>

			<div class="container" style="margin-top: 3rem;">
				<h2 class="text-center">Find Us</h2>
				<p class="lead text-center">{ADDRESS}</p>
				<div class="map-wrap">
					<iframe
						title="Map to 16517 Northcross Dr, Huntersville, NC"
						src={`https://www.openstreetmap.org/export/embed.html?bbox=${LNG - 0.02}%2C${LAT - 0.015}%2C${LNG + 0.02}%2C${LAT + 0.015}&layer=mapnik&marker=${LAT}%2C${LNG}`}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
					></iframe>
				</div>
				<p class="text-center" style="margin-top: 0.75rem; font-size: 0.9rem;">
					<a href={`https://www.openstreetmap.org/?mlat=${LAT}&mlon=${LNG}#map=16/${LAT}/${LNG}`} target="_blank" rel="noopener">View larger map</a>
					&nbsp;·&nbsp;
					<a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(ADDRESS)}`} target="_blank" rel="noopener">Open in Google Maps</a>
				</p>
			</div>
		</section>

		<Footer />
	</body>
</html>
