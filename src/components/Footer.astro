---
import { SITE_TITLE, ADDRESS, PHONE, PHONE_TEL, EMAIL } from '../consts';
---

<footer class="site-footer">
	<div class="container">
		<div class="footer-grid">
			<div>
				<div class="footer-brand">{SITE_TITLE}</div>
				<p>Local AC repair, installation, and maintenance specialists serving Huntersville, NC and the Lake Norman area. Quality work you can trust.</p>
				<p style="margin-top: 0.75rem; font-size: 0.95rem;">{ADDRESS}</p>
				<p style="font-size: 0.95rem;"><a href={`tel:${PHONE_TEL}`}>{PHONE}</a></p>
			</div>
			<div>
				<h4>Services</h4>
				<a href="/services/ac-repair">AC Repair</a>
				<a href="/services/ac-installation">AC Installation</a>
				<a href="/services/emergency-ac-repair">Emergency AC Repair</a>
				<a href="/services/maintenance">Maintenance Plans</a>
				<a href="/services/duct-cleaning">Duct Cleaning</a>
			</div>
			<div>
				<h4>Company</h4>
				<a href="/service-areas">Service Areas</a>
				<a href="/blog">Blog</a>
				<a href="/contact">Contact Us</a>
				<a href="/sitemap">Sitemap</a>
				<a href={`mailto:${EMAIL}`}>{EMAIL}</a>
			</div>
		</div>
		<div class="footer-bottom">
			&copy; {new Date().getFullYear()} {SITE_TITLE}. All rights reserved. | {ADDRESS}
		</div>
	</div>
</footer>
